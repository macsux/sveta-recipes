<!--
  Bolt control themes that replace FluentTheme's outright (keyed by type, so they win over Fluent's inside BoltTheme).
  Controls whose Fluent templates are kept (TextBox, ComboBox, menus, tooltips, scrollbars) are restyled in Styles.axaml.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="using:Bolt.Theme.Controls">

    <!-- ================================================================== Button
         default   raised secondary button (Review, Create PR)
         .accent   primary action (Save, Send when enabled)
         .ghost    no chrome until hovered (toolbar actions)
         .icon     .ghost, square, no padding (⋯, +, refresh)
         .row      a full-width list row; add .selected for the current one
         .subtle   compact transparent button (inline actions)
         .link     text-only, accent colored -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Bolt.Radius.Control}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{DynamicResource Bolt.ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource Bolt.FontSize.Control}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bolt.Bg.RaisedHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Border.Hover}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Selected}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Raised}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Faint}" />
        </Style>

        <Style Selector="^.accent">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Accent}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.OnAccent}" />
            </Style>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Accent.Hover}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Accent}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Raised}" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Faint}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="FontWeight" Value="Medium" />
            </Style>
        </Style>

        <Style Selector="^.ghost, ^.icon, ^.subtle, ^.row, ^.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Raised}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Primary}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Selected}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Ghost}" />
            </Style>
        </Style>
        <Style Selector="^.ghost, ^.icon">
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Muted}" />
        </Style>
        <Style Selector="^.icon">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="{DynamicResource Bolt.ControlHeight}" />
        </Style>
        <Style Selector="^.subtle">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="CornerRadius" Value="{DynamicResource Bolt.Radius.Row}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Hover}" />
            </Style>
        </Style>
        <Style Selector="^.row">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="{DynamicResource Bolt.FontSize.Body}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Bolt.Radius.Card}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Hover}" />
            </Style>
            <Style Selector="^.selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Border.Subtle}" />
            </Style>
        </Style>
        <Style Selector="^.link">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Accent.Text}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Accent}" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- ================================================================== ToggleButton
         default   like Button; checked = accent-tinted
         .pill     rounded mode chip (Plan / Fast / Approvals) -->
    <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type Button}}">
        <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Bolt.Accent.Tint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Accent.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Strong}" />
        </Style>
        <Style Selector="^.pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Border.Pill}" />
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Pill}" />
            <Setter Property="CornerRadius" Value="{DynamicResource Bolt.Radius.Pill}" />
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Raised}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Border.Pill}" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Primary}" />
            </Style>
            <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource Bolt.Accent.Tint}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Accent.Border}" />
                <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Strong}" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- ================================================================== CheckBox: 16px box, accent fill when checked -->
    <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{DynamicResource Bolt.FontSize.Body}" />
        <Setter Property="Padding" Value="10,0,0,0" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
                    <Border x:Name="Box" Width="16" Height="16" CornerRadius="{DynamicResource Bolt.Radius.Tag}"
                            Background="{DynamicResource Bolt.Bg.Input}" BorderBrush="{DynamicResource Bolt.Border.Strong}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <Panel>
                            <b:Icon x:Name="CheckGlyph" Data="{DynamicResource Bolt.Icon.Check}" Size="11" StrokeThickness="2.4"
                                    Foreground="{DynamicResource Bolt.Fg.OnAccent}" IsVisible="False" />
                            <b:Icon x:Name="DashGlyph" Data="{DynamicResource Bolt.Icon.Minus}" Size="11" StrokeThickness="2.4"
                                    Foreground="{DynamicResource Bolt.Fg.OnAccent}" IsVisible="False" />
                        </Panel>
                    </Border>
                    <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      TextWrapping="Wrap" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Box">
            <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Fg.Faint}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Box, ^:indeterminate /template/ Border#Box">
            <Setter Property="Background" Value="{DynamicResource Bolt.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Accent}" />
        </Style>
        <Style Selector="^:checked /template/ b|Icon#CheckGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:indeterminate /template/ b|Icon#DashGlyph">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ================================================================== Tabs: text tabs over a hairline, accent underline on the selected one -->
    <ControlTheme x:Key="{x:Type TabControl}" TargetType="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="20" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Background="{TemplateBinding Background}">
                    <DockPanel>
                        <Border x:Name="PART_TabStrip" DockPanel.Dock="Top" Padding="18,0" MinHeight="44"
                                BorderBrush="{DynamicResource Bolt.Border.Subtle}" BorderThickness="0,0,0,1">
                            <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Border>
                        <Panel ClipToBounds="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost2"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsVisible="False" />
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- .large: dialog-sized tab strip (Settings) -->
        <Style Selector="^.large /template/ Border#PART_TabStrip">
            <Setter Property="Padding" Value="32,0" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Chrome}" />
        </Style>
        <Style Selector="^.large /template/ ItemsPresenter#PART_ItemsPresenter > StackPanel">
            <Setter Property="Spacing" Value="24" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type TabItem}" TargetType="TabItem">
        <Setter Property="FontSize" Value="{DynamicResource Bolt.FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Subtle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      RecognizesAccessKey="True" />
                    <Border x:Name="PART_SelectedPipe" Height="2" VerticalAlignment="Bottom"
                            Background="{DynamicResource Bolt.Accent}" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Hover}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Strong}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Ghost}" />
        </Style>
    </ControlTheme>

    <!-- ================================================================== TitleBar: 38px chrome strip (+1px hairline) with a centered caption -->
    <ControlTheme x:Key="{x:Type b:TitleBar}" TargetType="b:TitleBar">
        <Setter Property="Height" Value="39" />
        <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Chrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Bolt.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource Bolt.Fg.Muted}" />
        <Setter Property="FontSize" Value="{DynamicResource Bolt.FontSize.Control}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="80,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <Panel>
                        <TextBlock x:Name="PART_Title" Text="{TemplateBinding Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                        <ContentPresenter x:Name="PART_ContentPresenter" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ================================================================== ProgressBar: 4px rounded meter -->
    <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Bolt.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Bolt.Bg.Track}" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                    <Panel>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                        <Border x:Name="IndeterminateIndicator" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}"
                                IsVisible="False" />

                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:indeterminate /template/ Border#IndeterminateIndicator">
            <Setter Property="IsVisible" Value="True" />
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>
</ResourceDictionary>
