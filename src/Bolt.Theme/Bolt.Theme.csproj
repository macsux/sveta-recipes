<Project Sdk="Microsoft.NET.Sdk">
  <!-- Self-contained design system for Avalonia apps: tokens, icons, fonts and control themes. No app dependencies. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Bolt.Theme</RootNamespace>
    <PackageId>Bolt.Theme</PackageId>
    <Description>Dark-first Avalonia theme (Geist type, graphite surfaces, single accent) built on top of FluentTheme.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>
</Project>
