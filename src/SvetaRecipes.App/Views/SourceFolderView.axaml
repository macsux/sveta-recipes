<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvetaRecipes.App.ViewModels"
             x:Class="SvetaRecipes.App.Views.SourceFolderView"
             x:DataType="vm:SourceFolderViewModel">
    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Classes="accent" Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" />
        </StackPanel>
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />
            <TextBlock Text="SOURCE CODE FOLDER" Classes="caption" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding Folder}" Classes="mono" />
                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
            </Grid>
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Classes="small secondary" IsVisible="{Binding IsUsable}" />
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Classes="small danger" IsVisible="{Binding !IsUsable}" />
            <Button Classes="link" Content="{Binding DefaultFolder, StringFormat='Use the default ({0})'}" Command="{Binding UseDefaultCommand}" />
        </StackPanel>
    </DockPanel>
</UserControl>
