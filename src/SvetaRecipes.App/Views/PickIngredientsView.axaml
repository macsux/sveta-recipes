<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvetaRecipes.App.ViewModels"
             xmlns:b="using:Bolt.Theme.Controls"
             x:Class="SvetaRecipes.App.Views.PickIngredientsView"
             x:DataType="vm:PickIngredientsViewModel">
    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
            <TextBlock Text="Add items" Classes="title" />
            <TextBlock Text="Tick the ingredients to add. Ones already on the list are not shown." Classes="small muted" TextWrapping="Wrap" />
            <TextBox Text="{Binding Search}" PlaceholderText="Search ingredients">
                <TextBox.InnerLeftContent>
                    <b:Icon Data="{StaticResource Bolt.Icon.Search}" Size="14" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
            </TextBox>
        </StackPanel>
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,200,*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <TextBlock Text="Store" Classes="secondary" VerticalAlignment="Center" />
            <AutoCompleteBox Grid.Column="1" ItemsSource="{Binding Stores}" Text="{Binding Store}" FilterMode="Contains" MinimumPrefixLength="0"
                             PlaceholderText="(each item's usual)" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Classes="accent" Content="Add to list" Command="{Binding AddCommand}" />
            </StackPanel>
        </Grid>
        <ListBox ItemsSource="{Binding Visible}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:IngredientPick">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
