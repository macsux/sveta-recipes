<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvetaRecipes.App.ViewModels"
             xmlns:svc="using:SvetaRecipes.App.Services"
             xmlns:b="using:Bolt.Theme.Controls"
             x:Class="SvetaRecipes.App.Views.IngredientsView"
             x:DataType="vm:IngredientsViewModel">
    <Grid RowDefinitions="Auto,*,Auto,230" Margin="16,12">
        <!-- toolbar -->
        <Grid ColumnDefinitions="300,240,*,Auto" ColumnSpacing="10">
            <TextBox Text="{Binding Search}" PlaceholderText="Search ingredients or comments">
                <TextBox.InnerLeftContent>
                    <b:Icon Data="{StaticResource Bolt.Icon.Search}" Size="14" Margin="10,0,0,0" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <ComboBox Grid.Column="1" ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding Filter}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="small muted" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                <Button Classes="accent" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <b:Icon Data="{StaticResource Bolt.Icon.Plus}" Size="14" />
                        <TextBlock Text="New ingredient" />
                    </StackPanel>
                </Button>
                <Button Classes="ghost" Content="Delete" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="Grid" Margin="0,10,0,0" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" SelectionMode="Extended" FrozenColumnCount="1">
            <DataGrid.Columns>
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="Ingredient" Binding="{Binding Name}" Width="2*" SortMemberPath="Name" />
                <DataGridTemplateColumn Header="Category" Width="170" SortMemberPath="Category.Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:IngredientRow">
                            <TextBlock Text="{Binding Category.Name}" Margin="10,0" VerticalAlignment="Center" Classes="secondary" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="vm:IngredientRow">
                            <ComboBox ItemsSource="{Binding $parent[DataGrid].((vm:IngredientsViewModel)DataContext).CategoryOptions}"
                                      SelectedItem="{Binding Category}" HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridCheckBoxColumn x:DataType="vm:IngredientRow" Header="Per piece" Binding="{Binding PerPiece}" Width="100" />
                <DataGridTemplateColumn Header="Unit" Width="80" SortMemberPath="Unit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="vm:IngredientRow">
                            <TextBlock Text="{Binding Unit}" Margin="10,0" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="vm:IngredientRow">
                            <ComboBox ItemsSource="{Binding $parent[DataGrid].((vm:IngredientsViewModel)DataContext).Units}"
                                      SelectedItem="{Binding Unit}" HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="Pack size" Width="100" SortMemberPath="PackQty"
                                    Binding="{Binding PackQty, Converter={x:Static svc:NumberConverter.Instance}}" />
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="Price" Width="90" SortMemberPath="PackPrice"
                                    Binding="{Binding PackPrice, Converter={x:Static svc:NumberConverter.Instance}}" />
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="$ / kg" Binding="{Binding PricePerKg}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="Recipes" Binding="{Binding UsedIn}" Width="96" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="Suppliers" Binding="{Binding Suppliers}" Width="104" IsReadOnly="True" />
                <DataGridTextColumn x:DataType="vm:IngredientRow" Header="Comments" Binding="{Binding Comments}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- batch -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8">
            <TextBlock Text="Selected rows → category" Classes="secondary" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding BatchCategory}" Width="220" />
            <Button Content="Apply" Command="{Binding SetCategoryCommand}" CommandParameter="{Binding #Grid.SelectedItems}" />
            <TextBlock Text="Shift- or Ctrl-click to select several rows." Classes="small muted" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <!-- details of the selected ingredient -->
        <TabControl Grid.Row="3">
            <TabItem Header="Used in recipes">
                <ListBox ItemsSource="{Binding UsedInRecipes}" Margin="0,6,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:RecipeUse">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <TextBlock Text="{Binding Recipe}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Amount}" Classes="mono muted" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Classes="link" Content="Open"
                                        Command="{Binding $parent[ListBox].((vm:IngredientsViewModel)DataContext).OpenRecipeCommand}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Supplier prices">
                <DockPanel Margin="0,6,0,0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <Button Content="Add supplier price" Command="{Binding AddPriceCommand}" />
                        <TextBlock Text="“Use” copies that price onto the ingredient, so recipes are costed with it." Classes="small muted" VerticalAlignment="Center" />
                    </StackPanel>
                    <DataGrid x:Name="PriceGrid" ItemsSource="{Binding Prices}" AutoGenerateColumns="False" CanUserSortColumns="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Supplier" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:SupplierPriceRow">
                                        <TextBlock Text="{Binding Supplier.Name}" Margin="10,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate DataType="vm:SupplierPriceRow">
                                        <ComboBox ItemsSource="{Binding $parent[DataGrid].((vm:IngredientsViewModel)DataContext).SupplierOptions}"
                                                  SelectedItem="{Binding Supplier}" HorizontalAlignment="Stretch" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:DataType="vm:SupplierPriceRow" Header="Brand" Binding="{Binding Brand}" Width="*" />
                            <DataGridTextColumn x:DataType="vm:SupplierPriceRow" Header="Unit" Binding="{Binding Unit}" Width="70" />
                            <DataGridTextColumn x:DataType="vm:SupplierPriceRow" Header="Pack size" Width="90"
                                                Binding="{Binding PackQty, Converter={x:Static svc:NumberConverter.Instance}}" />
                            <DataGridTextColumn x:DataType="vm:SupplierPriceRow" Header="Price" Width="90"
                                                Binding="{Binding PackPrice, Converter={x:Static svc:NumberConverter.Instance}}" />
                            <DataGridTextColumn x:DataType="vm:SupplierPriceRow" Header="$ / kg" Binding="{Binding PricePerKg}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn x:DataType="vm:SupplierPriceRow" Header="Comments" Binding="{Binding Comments}" Width="*" />
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="vm:SupplierPriceRow">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Classes="link" Content="Use" Command="{Binding $parent[DataGrid].((vm:IngredientsViewModel)DataContext).UsePriceCommand}" CommandParameter="{Binding}" />
                                            <Button Classes="link" Content="Remove" Command="{Binding $parent[DataGrid].((vm:IngredientsViewModel)DataContext).RemovePriceCommand}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
