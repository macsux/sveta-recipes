<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvetaRecipes.App.ViewModels"
             xmlns:b="using:Bolt.Theme.Controls"
             x:Class="SvetaRecipes.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">
    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="16,10,8,6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <b:Icon Data="{StaticResource Bolt.Icon.Bot}" Size="16" />
                <TextBlock Classes="h2" Text="Assistant" />
            </StackPanel>
            <ToggleButton Grid.Column="1" Classes="icon" IsChecked="{Binding ShowToolCalls}"
                          ToolTip.Tip="Show the assistant's tool calls (database queries, costing, web searches) in the conversation">
                <b:Icon Data="{StaticResource Bolt.Icon.Wrench}" Size="14" />
            </ToggleButton>
            <Button Grid.Column="2" Classes="icon" Command="{Binding NewChatCommand}" ToolTip.Tip="New chat">
                <b:Icon Data="{StaticResource Bolt.Icon.Plus}" Size="14" />
            </Button>
            <Button Grid.Column="3" Classes="icon" Click="Close" ToolTip.Tip="Hide the assistant">
                <b:Icon Data="{StaticResource Bolt.Icon.Close}" Size="14" />
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Classes="hairline" />

        <!-- Composer: the parts of the app she pointed at (if any) above it; point / send on its right -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="12,8,12,12">
            <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PickedAttachment">
                        <Border Classes="card" Padding="6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Image Source="{Binding Thumbnail}" MaxHeight="48" MaxWidth="100" Stretch="Uniform" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="caption" Text="Pointing at" />
                                    <TextBlock Classes="small" Text="{Binding Area.Summary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="icon" VerticalAlignment="Top" ToolTip.Tip="Remove"
                                        Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).RemoveAttachmentCommand}"
                                        CommandParameter="{Binding}">
                                    <b:Icon Data="{StaticResource Bolt.Icon.Close}" Size="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="Composer" Grid.Row="1" Classes="composer" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap"
                     MaxHeight="200" PlaceholderText="Ask about your recipes" KeyDown="OnComposerKeyDown" />
            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                <Button Classes="icon" HorizontalAlignment="Center" Click="PickArea"
                        ToolTip.Tip="Point at part of the app: click it, and the assistant gets a picture of it with your message (do it again to add more)">
                    <b:Icon Data="{StaticResource Bolt.Icon.Pin}" Size="14" />
                </Button>
                <Button Classes="accent" Command="{Binding SendCommand}" IsVisible="{Binding !IsBusy}" ToolTip.Tip="Send (Enter)">
                    <b:Icon Data="{StaticResource Bolt.Icon.ChevronRight}" Size="14" />
                </Button>
                <Button Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}" ToolTip.Tip="Stop">
                    <b:Icon Data="{StaticResource Bolt.Icon.Stop}" Size="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Conversation -->
        <Panel>
            <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" Margin="28,0" Spacing="8">
                <TextBlock Classes="h2" Text="Ask me anything about your recipes" HorizontalAlignment="Center" />
                <TextBlock Classes="secondary" TextWrapping="Wrap" TextAlignment="Center"
                           Text="What does a recipe cost? Which recipes use pistachio paste? Who hasn't paid? Paste a recipe or a link and I'll check whether you already have it, and add it if you ask." />
            </StackPanel>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,12,16,12" Spacing="10">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:UserChatItem">
                                <Border Classes="bubble" HorizontalAlignment="Right" Margin="40,0,0,0">
                                    <StackPanel Spacing="8">
                                        <ItemsControl ItemsSource="{Binding Pictures}" IsVisible="{Binding HasPictures}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemSpacing="6" LineSpacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChatPicture">
                                                    <Button Classes="ghost" Padding="0" Click="OpenPicture" ToolTip.Tip="Open the picture">
                                                        <Image Source="{Binding Image}" MaxHeight="120" MaxWidth="300" Stretch="Uniform" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:AssistantChatItem">
                                <b:MarkdownBlock Markdown="{Binding Text}" />
                            </DataTemplate>
                            <DataTemplate DataType="vm:ToolChatItem">
                                <StackPanel Spacing="6" IsVisible="{Binding IsShown}">
                                    <ToggleButton Classes="pill" IsChecked="{Binding IsExpanded}" HorizontalAlignment="Left"
                                                  ToolTip.Tip="Show / hide the details">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <b:Icon Data="{StaticResource Bolt.Icon.Check}" Size="12" IsVisible="{Binding !Failed}" />
                                            <b:Icon Data="{StaticResource Bolt.Icon.Alert}" Size="12" IsVisible="{Binding Failed}" />
                                            <TextBlock Classes="small" Text="{Binding Label}" />
                                            <Border Classes="badge"><TextBlock Text="{Binding Tool}" /></Border>
                                            <b:Spinner Size="10" IsVisible="{Binding !HasResult}" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Border Classes="card" Padding="10,8" IsVisible="{Binding IsExpanded}">
                                        <StackPanel Spacing="8">
                                            <StackPanel Spacing="4" IsVisible="{Binding HasInput}">
                                                <TextBlock Classes="caption" Text="Input" />
                                                <SelectableTextBlock Classes="mono small" Text="{Binding Input}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Classes="hairline" IsVisible="{Binding HasInput}" />
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="caption" Text="Result" />
                                                <SelectableTextBlock Classes="mono small" Text="{Binding Result}" TextWrapping="Wrap"
                                                                     IsVisible="{Binding HasResult}" />
                                                <TextBlock Classes="small muted" Text="(waiting)" IsVisible="{Binding !HasResult}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                            <DataTemplate DataType="vm:NoteChatItem">
                                <TextBlock Classes="small muted" Text="{Binding Text}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            </DataTemplate>
                            <DataTemplate DataType="vm:ErrorChatItem">
                                <SelectableTextBlock Classes="error" Text="{Binding Text}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
                        <b:Spinner Size="12" />
                        <TextBlock Classes="small muted" Text="Working…" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</UserControl>
