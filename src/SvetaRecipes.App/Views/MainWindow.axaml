<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvetaRecipes.App.ViewModels"
        xmlns:b="using:Bolt.Theme.Controls"
        x:Class="SvetaRecipes.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sveta's Recipes"
        Width="1360" Height="820" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <!-- The assistant is a collapsible column on the right; its width is set in code-behind (0 while hidden). -->
    <Grid x:Name="Root" ColumnDefinitions="*,Auto,0">
        <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0">
            <TabItem Header="Recipes">
                <ContentControl Content="{Binding Recipes}" />
            </TabItem>
            <TabItem Header="Ingredients">
                <ContentControl Content="{Binding Ingredients}" />
            </TabItem>
            <TabItem Header="Shopping lists">
                <ContentControl Content="{Binding Shopping}" />
            </TabItem>
            <TabItem Header="Invoices">
                <ContentControl Content="{Binding Invoices}" />
            </TabItem>
            <TabItem Header="Customers &amp; suppliers">
                <ContentControl Content="{Binding Companies}" />
            </TabItem>
            <TabItem Header="Tools &amp; settings">
                <ContentControl Content="{Binding Tools}" />
            </TabItem>
        </TabControl>
        <ToggleButton Classes="pill" IsChecked="{Binding IsAssistantOpen}" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,8,12,0" ToolTip.Tip="Show or hide the assistant">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <b:Icon Data="{StaticResource Bolt.Icon.Chat}" Size="14" />
                <TextBlock Text="Assistant" />
            </StackPanel>
        </ToggleButton>
        <GridSplitter Grid.Column="1" Width="1" IsVisible="{Binding IsAssistantOpen}" />
        <ContentControl Grid.Column="2" Content="{Binding Assistant}" IsVisible="{Binding IsAssistantOpen}" />
    </Grid>
</Window>
