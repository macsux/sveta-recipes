<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SvetaRecipes.App.ViewModels"
        xmlns:b="using:Bolt.Theme.Controls"
        x:Class="SvetaRecipes.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Sveta's Recipes"
        Width="1360" Height="820" MinWidth="1100" MinHeight="660"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <!-- The assistant is a collapsible column on the right; its width is set in code-behind (0 while hidden). -->
    <Grid x:Name="Root" ColumnDefinitions="*,Auto,0" RowDefinitions="Auto,*">
        <StackPanel Grid.ColumnSpan="3">
        <!-- Development mode: building / checking, a change ready to apply, or what went wrong. -->
        <Border Classes="card" Margin="12,8,12,4" Padding="14,8" IsVisible="{Binding Dev.HasStatus}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                <Panel VerticalAlignment="Center">
                    <b:Spinner Size="14" IsVisible="{Binding Dev.IsWorking}" />
                    <b:Icon Data="{StaticResource Bolt.Icon.Alert}" Size="14" IsVisible="{Binding Dev.Failed}" />
                    <b:Icon Data="{StaticResource Bolt.Icon.Branch}" Size="14" IsVisible="{Binding Dev.IsReady}" />
                </Panel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Dev.Status}" />
                <Button Grid.Column="2" Classes="link" Content="Show details" Command="{Binding Dev.ShowLogCommand}" IsVisible="{Binding Dev.HasLog}" />
                <Button Grid.Column="3" Classes="ghost" Content="Not now" Command="{Binding Dev.DismissCommand}" IsVisible="{Binding !Dev.IsWorking}" />
                <Button Grid.Column="4" Classes="accent" Content="Apply changes" Command="{Binding Dev.ApplyCommand}"
                        IsVisible="{Binding Dev.IsReady}" IsEnabled="{Binding !Assistant.IsBusy}"
                        ToolTip.Tip="Restart the app with the assistant's changes (unsaved edits are asked about first)" />
            </Grid>
        </Border>
        <!-- A downloaded update: restart into it now, or later (it installs when the app closes). -->
        <Border Classes="card" Margin="12,8,12,4" Padding="14,8" IsVisible="{Binding IsUpdateReady}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <b:Icon Data="{StaticResource Bolt.Icon.Refresh}" Size="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="A new version of Sveta's Recipes is ready (" /><Run Text="{Binding UpdateReady}" /><Run Text=")." />
                    <Run Text="Restart to start using it, or carry on and it installs when you close the app." Foreground="{DynamicResource Bolt.Fg.Muted}" />
                </TextBlock>
                <Button Grid.Column="2" Classes="ghost" Content="Later" Command="{Binding DismissUpdateCommand}" />
                <Button Grid.Column="3" Classes="accent" Content="Restart now" Click="RestartForUpdate" />
            </Grid>
        </Border>
        </StackPanel>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Padding="0">
            <TabItem Header="Recipes">
                <ContentControl Content="{Binding Recipes}" />
            </TabItem>
            <TabItem Header="Ingredients">
                <ContentControl Content="{Binding Ingredients}" />
            </TabItem>
            <TabItem Header="Shopping lists">
                <ContentControl Content="{Binding Shopping}" />
            </TabItem>
            <TabItem Header="Invoices">
                <ContentControl Content="{Binding Invoices}" />
            </TabItem>
            <TabItem Header="Customers &amp; suppliers">
                <ContentControl Content="{Binding Companies}" />
            </TabItem>
            <TabItem Header="Tools &amp; settings">
                <ContentControl Content="{Binding Tools}" />
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0">
            <!-- Release (the installed app) or Development (built from the local source, which the assistant can change). -->
            <ToggleButton x:Name="ModeToggle" Classes="pill" Click="ToggleMode"
                          ToolTip.Tip="Release: the installed app. Development: the app runs from its source code on this computer, and the assistant can change the app itself.">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <b:Icon Data="{StaticResource Bolt.Icon.Branch}" Size="14" />
                    <TextBlock Text="{Binding Dev.ModeLabel}" />
                </StackPanel>
            </ToggleButton>
            <ToggleButton Classes="pill" IsChecked="{Binding IsAssistantOpen}" ToolTip.Tip="Show or hide the assistant">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <b:Icon Data="{StaticResource Bolt.Icon.Chat}" Size="14" />
                    <TextBlock Text="Assistant" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="1" IsVisible="{Binding IsAssistantOpen}" />
        <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding Assistant}" IsVisible="{Binding IsAssistantOpen}" />
    </Grid>
</Window>
