<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SvetaRecipes.App.ViewModels"
             x:Class="SvetaRecipes.App.Views.PrintLabelsView"
             x:DataType="vm:PrintLabelsViewModel">
    <DockPanel Margin="20,16">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
            <TextBlock Text="Print labels" Classes="title" />
            <TextBlock Text="Set how many copies of each label to print. GF / DF tags and the charge code print on the label." Classes="small muted" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Sheet" Classes="secondary" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Columns}" Minimum="1" Maximum="6" Increment="1" FormatString="0" Width="110" />
                <TextBlock Text="across ×" VerticalAlignment="Center" />
                <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="110" />
                <TextBlock Text="down" VerticalAlignment="Center" />
            </StackPanel>
            <CheckBox Content="Mark these recipes as “label printed”" IsChecked="{Binding MarkPrinted}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
                <Button Classes="accent" Content="Print" Command="{Binding PrintCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
        <ListBox ItemsSource="{Binding Labels}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:LabelPick">
                    <Grid ColumnDefinitions="*,130" ColumnSpacing="10">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Text}" Classes="small muted" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Value="{Binding Copies}" Minimum="0" Maximum="200" Increment="1" FormatString="0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
