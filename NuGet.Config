<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only: <clear/> drops sources from any NuGet.Config above the repo or the user's own,
     so a build behaves the same on every machine (andrew's Mac, her PC in development mode). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
